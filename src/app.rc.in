#include <windows.h>
101 ICON "@CMAKE_CURRENT_SOURCE_DIR@/assets/app.ico"
102 RCDATA "@CMAKE_CURRENT_SOURCE_DIR@/assets/banner.png"
1 RT_MANIFEST "@CMAKE_CURRENT_SOURCE_DIR@/src/app.manifest"
VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEOS 0x40004L
 FILETYPE 0x1L
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "FileDescription", "SANGUE by suki\0"
   VALUE "ProductName", "SANGUE\0"
   VALUE "FileVersion", "@PROJECT_VERSION@\0"
   VALUE "ProductVersion", "@PROJECT_VERSION@\0"
   VALUE "OriginalFilename", "SANGUE.exe\0"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x409, 1200
 END
END
